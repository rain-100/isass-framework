<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.1.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.1.0 http://maven.apache.org/xsd/assembly-2.1.0.xsd">
    <id>bin</id>
    <formats>
        <format>tar.gz</format>
    </formats>
    <includeBaseDirectory>false</includeBaseDirectory>
    <dependencySets>
        <!-- 把 isass-core-build 模块的通用部署说明和 Windows 脚本复制到压缩包中 -->
        <dependencySet>
            <outputDirectory>${project.artifactId}</outputDirectory>
            <includes>
                <include>vip.isass:isass-core-build</include>
            </includes>
            <unpack>true</unpack>
            <unpackOptions>
                <includes>
                    <include>deploy.md</include>
                    <include>win_start.bat</include>
                    <include>win_service_install.bat</include>
                    <include>win_service_start.bat</include>
                    <include>win_service_stop.bat</include>
                    <include>win_service_uninstall.bat</include>
                </includes>
                <filtered>true</filtered>
            </unpackOptions>
        </dependencySet>

        <dependencySet>
            <outputDirectory>${project.artifactId}</outputDirectory>
            <includes>
                <include>vip.isass:isass-core-build</include>
            </includes>
            <unpack>true</unpack>
            <unpackOptions>
                <includes>
                    <include>JavaService.exe</include>
                </includes>
                <filtered>false</filtered>
            </unpackOptions>
        </dependencySet>

        <!-- 把 isass-core-build 模块的 Linux 脚本复制到压缩包中，并赋予可执行权限 -->
        <dependencySet>
            <outputDirectory>${project.artifactId}</outputDirectory>
            <includes>
                <include>vip.isass:isass-core-build</include>
            </includes>
            <fileMode>0755</fileMode>
            <unpack>true</unpack>
            <unpackOptions>
                <includes>
                    <include>run.sh</include>
                    <include>stop.sh</include>
                    <include>printlog.sh</include>
                </includes>
                <filtered>true</filtered>
            </unpackOptions>
        </dependencySet>
    </dependencySets>

    <fileSets>
        <!-- 把项目中 lib 目录的文件复制到压缩包中 -->
        <fileSet>
            <directory>${project.build.directory}/lib</directory>
            <outputDirectory>${project.artifactId}/lib</outputDirectory>
            <includes>
                <include>*.*</include>
            </includes>
        </fileSet>

        <!-- 把项目中 config 目录的文件复制到压缩包中 -->
        <fileSet>
            <directory>${project.build.outputDirectory}/config</directory>
            <outputDirectory>${project.artifactId}/config</outputDirectory>
        </fileSet>

        <!-- 把项目中 git 版本文件复制到压缩包中 -->
        <fileSet>
            <directory>${project.build.outputDirectory}</directory>
            <outputDirectory>${project.artifactId}</outputDirectory>
            <includes>
                <include>git.properties</include>
            </includes>
        </fileSet>

        <!-- 把项目中 spring-boot-maven-plugin 插件编译出来的可执行 jar 包复制到压缩包中 -->
        <fileSet>
            <directory>${project.build.directory}</directory>
            <outputDirectory>${project.artifactId}</outputDirectory>
            <includes>
                <include>*-exec.jar</include>
            </includes>
        </fileSet>
    </fileSets>
</assembly>

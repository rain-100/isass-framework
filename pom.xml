<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 http://maven.apache.org/xsd/maven-4.1.0.xsd"
         root="true">
    <modelVersion>4.1.0</modelVersion>

    <!-- 本项目信息 -->
    <!-- 正式版格式：isass-framework.x.y.z-release-->
    <!-- 快照版格式：isass-framework.x.y.z-SNAPSHOT-->
    <groupId>vip.isass</groupId>
    <artifactId>isass-framework</artifactId>
    <version>4.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <subprojects>
        <!-- core -->
        <subproject>isass-core-build</subproject>
        <subproject>isass-core-common</subproject>
        <subproject>isass-core-dependencies</subproject>
        <subproject>isass-core-parent</subproject>
        <subproject>isass-entrypoint-core</subproject>
        <subproject>isass-entrypoint-registry</subproject>
        <subproject>isass-entrypoint-http</subproject>
        <subproject>isass-entrypoint-grpc</subproject>
        <subproject>isass-nocode-core</subproject>
        <subproject>isass-nocode-generator</subproject>

        <!-- database -->
        <subproject>isass-database-core</subproject>
        <subproject>isass-database-dameng</subproject>
        <subproject>isass-database-elasticsearch</subproject>
        <subproject>isass-database-redis</subproject>
        <subproject>isass-database-mybatisplus</subproject>

        <!-- mq -->
        <subproject>isass-mq-kafka011</subproject>
        <subproject>isass-mq-springevent</subproject>
        <subproject>isass-mq-redisstream</subproject>
        <subproject>isass-mq-redispubsub</subproject>
        <subproject>isass-mq-core</subproject>

        <!-- net -->
        <subproject>isass-net-admin</subproject>
        <subproject>isass-net-core</subproject>
        <subproject>isass-net-netty</subproject>
        <subproject>isass-net-proxy-core</subproject>
        <subproject>isass-net-proxy-server</subproject>
        <subproject>isass-net-proxy-upstream</subproject>
        <subproject>isass-net-socketio</subproject>
        <subproject>isass-net-websocket</subproject>

        <!-- security -->
        <subproject>isass-security-springsecurity</subproject>
        <subproject>isass-encryption</subproject>

        <!-- serialization -->
        <subproject>isass-serialization-protobuf</subproject>

        <!-- web -->
        <subproject>isass-web-springmvc</subproject>

        <!-- adapter -->
        <subproject>isass-adapter-springboot</subproject>
    </subprojects>


    <!-- 配置属性 -->
    <properties>
        <!-- region build properties -->

        <java.version>25</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.encoding>UTF-8</maven.compiler.encoding>
        <maven.compiler.release>${java.version}</maven.compiler.release>

        <!-- endregion -->
    </properties>

    <licenses>
        <license>
            <name>GNU Lesser General Public License v3.0 only</name>
            <url>https://www.gnu.org/licenses/lgpl-3.0.html</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <scm>
        <tag>master</tag>
        <url>https://gitee.com/isass/super</url>
        <connection>scm:git:git@gitee.com:isass/isass-framework.git</connection>
        <developerConnection>scm:git:git@gitee.com:isass/isass-framework.git</developerConnection>
    </scm>

    <developers>
        <developer>
            <name>Rain Lee</name>
            <email>lizhirong100@163.com</email>
            <organization>isass</organization>
        </developer>
    </developers>
</project>
